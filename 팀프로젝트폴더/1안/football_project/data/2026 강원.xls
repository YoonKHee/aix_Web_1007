<title>K LEAGUE PORTAL</title>
<script>
function goExcel(){
	
	if($("#tmpPopFrm").length>=1){
		$("#tmpPopFrm").remove();
	}
	
	var paramObj = {
			selectYear:$("#selectYear").val(),
			selectMeetSeq:$("#selectMeetSeq").val(),
			selectTeamId:$("#selectTeamId").val(),
			selectGameId:$("#selectGameId").val()
		};

	var html="<form method='post' name='tmpPopFrm' id='tmpPopFrm' action='/data/addition/player/additionPlayerDataBySeasonPopupExcel.do'>";
	for(var key in paramObj){
		html+="<input type='hidden' name='"+key+"' value='"+paramObj[key]+"'/>";
	}
	html+="</form>";
	$("body").append(html);
	
	submitToPopupPage(document.forms.tmpPopFrm, "popPlayerAdditionDataSeason", 500, 500);

}

$(document).ready(function(){
	$("#teamDataTableSeason").tablesorter({
		 headers : {
	        	0 : {sorter : 'desc'},
	        	1 : {sorter : 'text'},
	            2 : {sorter : 'desc'},
	            3 : {sorter : 'desc'},
	            4 : {sorter : 'desc'},
	            5 : {sorter : 'desc'},
	            6 : {sorter : 'desc'},
	            7 : {sorter : 'desc'},
	            8 : {sorter : 'desc'},
	            9 : {sorter : 'percent'},
	            10 : {sorter : 'desc'},
	            11 : {sorter : 'desc'},
	            12 : {sorter : 'desc'},
	            13 : {sorter : 'desc'},
	            14 : {sorter : 'percent'},
	            15 : {sorter : 'desc'},
	            16 : {sorter : 'desc'},
	            17 : {sorter : 'desc'},
	            18 : {sorter : 'desc'},
	            19 : {sorter : 'desc'},
	            20 : {sorter : 'percent'},
	            21 : {sorter : 'desc'},
	            22 : {sorter : 'desc'},
	            23 : {sorter : 'percent'},
	            24 : {sorter : 'desc'},
	            25 : {sorter : 'desc'},
	            26 : {sorter : 'percent'},
	            27 : {sorter : 'desc'},
	            28 : {sorter : 'desc'},
	            29 : {sorter : 'percent'},
	            30 : {sorter : 'desc'},
	            31 : {sorter : 'desc'},
	            32 : {sorter : 'percent'},
	            33 : {sorter : 'desc'},
	            34 : {sorter : 'desc'},
	            35 : {sorter : 'percent'},
	            36 : {sorter : 'desc'},
	            37 : {sorter : 'desc'},
	            38 : {sorter : 'percent'},
	            39 : {sorter : 'desc'},
	            40 : {sorter : 'desc'},
	            41 : {sorter : 'desc'},
	            42 : {sorter : 'desc'},
	            43 : {sorter : 'desc'}
	          },
	});      
	full();
});
function full(){
	var w = screen.width;
	var h = screen.height;
	window.resizeTo (w,h);
	window.moveTo (0,0);
}
</script>
