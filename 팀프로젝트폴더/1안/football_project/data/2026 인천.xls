	            17 : {sorter : 'desc'},
	            18 : {sorter : 'desc'},
	            19 : {sorter : 'desc'},
	            20 : {sorter : 'percent'},
	            21 : {sorter : 'desc'},
	            22 : {sorter : 'desc'},
	            23 : {sorter : 'percent'},
	            24 : {sorter : 'desc'},
	            25 : {sorter : 'desc'},
	            26 : {sorter : 'percent'},
	            27 : {sorter : 'desc'},
	            28 : {sorter : 'desc'},
	            29 : {sorter : 'percent'},
	            30 : {sorter : 'desc'},
	            31 : {sorter : 'desc'},
	            32 : {sorter : 'percent'},
	            33 : {sorter : 'desc'},
	            34 : {sorter : 'desc'},
	            35 : {sorter : 'percent'},
	            36 : {sorter : 'desc'},
	            37 : {sorter : 'desc'},
